# Duplicate this file as .env and fill in the values locally.
APP_ID=
APP_SECRET=
DEEPSEEK_API_KEY=
# Optional API key for public web search.
BRAVE_SEARCH_API_KEY=
JENKINS_USERNAME=
JENKINS_API_TOKEN=

# Local Kubernetes only. Use the kubeconfig path and exact context name.
HOLMES_KUBECONFIG=
HOLMES_KUBE_CONTEXT=

# Optional read-only Prometheus endpoint scoped to one environment.
# URL is the API base reachable by the bot; environment is your label (e.g. uat).
PROMETHEUS_URL=
PROMETHEUS_ENVIRONMENT=
PROMETHEUS_BEARER_TOKEN=

# Feishu folder token for the knowledge base (not the whole URL).
# The app needs read access to that folder and its Docx documents.
# The local index currently skips non-Docx file types.
FEISHU_KNOWLEDGE_FOLDER_TOKEN=
